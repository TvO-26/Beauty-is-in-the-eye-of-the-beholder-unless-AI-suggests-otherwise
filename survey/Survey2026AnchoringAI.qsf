Text":"Hoe oud bent u?","Choices":{"1":{"Display":"Jonger dan 18"},"2":{"Display":"18-24 jaar"},"3":{"Display":"25-34 jaar"},"4":{"Display":"35-44 jaar"},"5":{"Display":"45-54 jaar"},"6":{"Display":"55-64 jaar"},"7":{"Display":"65+"}}},"PT-BR":{"QuestionText":"Qual \u00e9 a sua idade?","Choices":{"1":{"Display":"Menos de 18"},"2":{"Display":"18 a 24 anos"},"3":{"Display":"25 a 34 anos"},"4":{"Display":"35 a 44 anos"},"5":{"Display":"45 a 54 anos"},"6":{"Display":"55 a 64 anos"},"7":{"Display":"65 anos ou mais"}}},"ZH-S":{"QuestionText":"\u60a8\u7684\u5e74\u9f84\u662f\uff1f","Choices":{"1":{"Display":"18 \u5c81\u4ee5\u4e0b"},"2":{"Display":"18-24 \u5c81"},"3":{"Display":"25-34 \u5c81"},"4":{"Display":"35-44 \u5c81"},"5":{"Display":"45-54 \u5c81"},"6":{"Display":"55-64 \u5c81"},"7":{"Display":"65 \u5c81\u4ee5\u4e0a"}}},"ZH-T":{"QuestionText":"\u60a8\u5e7e\u6b72\uff1f","Choices":{"1":{"Display":"\u4e0d\u5230 18 \u6b72"},"2":{"Display":"18-24 \u6b72"},"3":{"Display":"25-34 \u6b72"},"4":{"Display":"35-44 \u6b72"},"5":{"Display":"45-54 \u6b72"},"6":{"Display":"55-64 \u6b72"},"7":{"Display":"65 \u6b72\u4ee5\u4e0a"}}}},"NextAnswerId":1,"NextChoiceId":8,"QuestionDescription":"How old are you?","QuestionText":"How old are you?","QuestionText_Unsafe":"How old are you?","QuestionType":"MC","ReferenceQuestionConfig":{"instanceOf":{"id":"RQ_OhWcN0iu9Pioww2","version":"v2.0.0"}},"SchemaConfig":{"ChoiceMapping":{"1":"enu:\/\/lessthan18","2":"enu:\/\/18-24","3":"enu:\/\/25-34","4":"enu:\/\/35-44","5":"enu:\/\/45-54","6":"enu:\/\/55-64","7":"enu:\/\/65andolder"},"ChoiceMappingType":"Member","ConfigVersion":"1.0.0","Reconfirm":true,"URL":"ses:\/\/agerange","XMDConnect":true},"Selector":"SAVR","SubSelector":"TX","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"DataExportTag":"Age","QuestionID":"QID12"}},{"SurveyID":"SV_3dVyjdGXdWxhr0O","Element":"SQ","PrimaryAttribute":"QID1220402710","SecondaryAttribute":"On average, how often do you use an AI chatbot (such as ChatGPT, Gemini, or Copilot) to do any of...","TertiaryAttribute":null,"Payload":{"QuestionText":"On average, how often do you use an AI chatbot (such as ChatGPT, Gemini, or Copilot) to do any of the following?&nbsp;","DefaultChoices":false,"QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"On average, how often do you use an AI chatbot (such as ChatGPT, Gemini, or Copilot) to do any of...","Choices":{"1":{"Display":"To search for information"},"2":{"Display":"For tasks at work"},"3":{"Display":"For fun or entertainment"},"4":{"Display":"To create or edit images or videos"},"6":{"Display":"To get news"},"7":{"Display":"For emotional support or advice"},"8":{"Display":"To summarize an article, book, or video"},"9":{"Display":"For casual conversation"}},"ChoiceOrder":["1","2","3","4","6","7","8","9"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":10,"NextAnswerId":5,"Answers":{"1":{"Display":"Less than once a week"},"2":{"Display":"1-2 times a week"},"3":{"Display":"3-5 times a week"},"4":{"Display":"Daily"}},"AnswerOrder":["1","2","3","4"],"ChoiceDataExportTags":false,"QuestionText_Unsafe":"On average, how often do you use an AI chatbot (such as ChatGPT, Gemini, or Copilot) to do any of the following?&nbsp;","DataExportTag":"AI usage","QuestionID":"QID1220402710"}},{"SurveyID":"SV_3dVyjdGXdWxhr0O","Element":"SQ","PrimaryAttribute":"QID16","SecondaryAttribute":"Aesthetic Perception Research Dear participant, thank you for your interest in this study. Proced...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"font-family: sans-serif; line-height: 1.5; color: #333; max-width: 800px; font-size: 14px;\">\n    \n    <h4 style=\"color: #000; border-bottom: 2px solid #ccc; padding-bottom: 10px; font-size: 1.3em;\">Aesthetic Perception Research<\/h4>\n    \n    <p>Dear participant, thank you for your interest in this study.<\/p>\n\n    <h5 style=\"margin-top: 20px; color: #000; font-size: 1.1em;\">Procedure<\/h5>\n    <p>This 5-minute study consists of demographic questions, aesthetic ratings of 27 paintings, and a few questions regarding your art and AI habits. It concludes with a short debriefing.<\/p>\n\n    <h5 style=\"margin-top: 20px; color: #000; font-size: 1.1em;\">Data Protection<\/h5>\n    <p>In this research carried out by the University of Amsterdam, your participation is voluntary and strictly confidential. All data is anonymized and used only for scientific research.&nbsp;<\/p>\n<\/div>","DefaultChoices":false,"DataExportTag":"Consent","QuestionID":"QID16","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Aesthetic Perception Research Dear participant, thank you for your interest in this study. Proced...","Choices":{"4":{"Display":"I consent to participate in this study."},"5":{"Display":"I do not consent to participate."}},"ChoiceOrder":["4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionJS":false}},{"SurveyID":"SV_3dVyjdGXdWxhr0O","Element":"SQ","PrimaryAttribute":"QID17","SecondaryAttribute":"Thank you so much for taking the time to complete this study. What were we studying? Now that you...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"font-family: sans-serif; line-height: 1.6; color: #333; max-width: 800px;\">\n<h3 style=\"color: rgb(0, 0, 0); border-bottom: 2px solid rgb(204, 204, 204); padding-bottom: 10px;\">Thank you so much for taking the time to complete this study.<\/h3>\n\n<h3 style=\"margin-top: 25px; color: #000;\"><u><span style=\"font-size:13px;\">What were we studying?<\/span><\/u><\/h3>\n\n<p><span style=\"font-size:13px;\">Now that you have completed the tasks, we can share a little more about the purpose of this study.<\/span><\/p>\n\n<p>&nbsp;<\/p>\n<span style=\"font-size:13px;\">We are investigating <strong>how humans respond to suggestions when evaluating art.<\/strong> The ratings you saw, however, were experimental anchors and not accurate reflections of the aesthetic ratings.<\/span>\n\n<p>&nbsp;<\/p>\n\n<p><span style=\"font-size:13px;\">You may have noticed some of the ratings provided by an &quot;AI&quot; or &quot;another participant&quot;. That was part of our experiment! We are curious whether we trust an opinion generated by Artificial Intelligence on art as much as we trust a fellow human&#39;s.<\/span><\/p>\n\n<p>&nbsp;<\/p>\n\n<p><span style=\"font-size:13px;\">If you have any further questions about the study or your data, please do not hesitate to contact Thekla van Oijen at <a href=\"mailto:t.q.vanoijen@uva.nl\">t.q.vanoijen@uva.nl<\/a>.<\/span><\/p>\n<\/div>","DefaultChoices":false,"DataExportTag":"Q17","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Thank you so much for taking the time to complete this study. What were we studying? Now that you...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID17"}},{"SurveyID":"SV_3dVyjdGXdWxhr0O","Element":"SQ","PrimaryAttribute":"QID21","SecondaryAttribute":"Next, you will be shown a series of 27 images. For each image, please provide an aesthetic rating...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style =\"font-family:sans-serif; line-height:1.6;color:#333; max-width:700px;margin: 0 auto; font-size: 15px;\"\n    <p style=\"margin-bottom: 20px;\">\n        Next, you will be shown a series of 27 images. For each image, please provide an aesthetic rating on a scale of 1 to 10, where <strong>1<\/strong> is <strong>very unaesthetically pleasing<\/strong> and <strong>10<\/strong> is <strong>very aesthetically pleasing<\/strong>. \n    <\/p>\n\n    <p style=\"margin-bottom: 20px;\">\n        As you view the images, you will sometimes be shown ratings previously provided by an 'Image Aesthetics Assessment' model (Artificial Intelligence), or ratings provided by another participant who has completed this study. \n    <\/p>\n\n    <p style=\"margin-bottom: 20px;\">\n        Please trust your immediate, intuitive response, and feel free to move through the images at your own pace.\n    <\/p>\n<\/div>","DefaultChoices":false,"DataExportTag":"Intro","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Next, you will be shown a series of 27 images. For each image, please provide an aesthetic rating...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID21"}},{"SurveyID":"SV_3dVyjdGXdWxhr0O","Element":"SQ","PrimaryAttribute":"QID4","SecondaryAttribute":"\u00a0 How aesthetic do you find this image? Please consider how beautiful it is, how much you like it..","TertiaryAttribute":null,"Payload":{"QuestionText":"<div class=\"painting-wrapper\">\n<div id=\"image-counter\">&nbsp;<\/div>\n<img class=\"painting-image\" src=\"${lm:\/\/Field\/2}\" \/>\n<div class=\"QuestionText\"><span style =\"font-family:sans-serif; line-height:1.6;color:#333; max-width:700px;margin: 0 auto; font-size: 15px;\"><b>How aesthetic do you find this image?<\/b><\/span><br \/>\n<span style =\"font-family:sans-serif; line-height:1.6;color:#333; max-width:700px;margin: 0 auto; font-size: 15px;\">Please consider how beautiful it is, how much you like it, and how drawn you are to it.<\/span><\/div>\n\n<div id=\"my-prompt\">&nbsp;<\/div>\n<\/div>","DefaultChoices":false,"DataExportTag":"Template","QuestionType":"Slider","Selector":"HSLIDER","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"above","CSSliderMin":0,"CSSliderMax":10,"GridLines":10,"SnapToGrid":true,"NumDecimals":0,"ShowValue":true,"CustomStart":true,"NotApplicable":false,"MobileFirst":true,"SliderStartPositions":{"1":0}},"QuestionDescription":"\u00a0 How aesthetic do you find this image? Please consider how beautiful it is, how much you like it...","Choices":{"1":{"Display":"&nbsp;"}},"ChoiceOrder":[1],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":3,"NextAnswerId":3,"Labels":[],"ChoiceDataExportTags":false,"QuestionID":"QID4","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function () {\n\n    \/\/ Initialize ConditionDeck once\n    var deck = Qualtrics.SurveyEngine.getEmbeddedData(\"ConditionDeck\");\n\n    if (!deck) {\n\n        var newDeck = [];\n\n        for (var i = 0; i < 9; i++) newDeck.push(0);\n        for (var i = 0; i < 9; i++) newDeck.push(1);\n        for (var i = 0; i < 9; i++) newDeck.push(2);\n\n        \/\/ Shuffle\n        for (var i = newDeck.length - 1; i > 0; i--) {\n            var j = Math.floor(Math.random() * (i + 1));\n            var temp = newDeck[i];\n            newDeck[i] = newDeck[j];\n            newDeck[j] = temp;\n        }\n\n        Qualtrics.SurveyEngine.setEmbeddedData(\n            \"ConditionDeck\",\n            newDeck.join(\",\")\n        );\n\n        deck = newDeck.join(\",\");\n\t}\n});\n\n\nQualtrics.SurveyEngine.addOnReady(function () {\n\n    console.log(\"Raw Loop variable:\", \"${lm:\/\/CurrentLoopNumber}\");\n\t\n\tvar loopNumber = Number(\"${lm:\/\/CurrentLoopNumber}\"); \n\t\n\tconsole.log(\"Parsed loop number\", loopNumber);\n\n    var deckString = Qualtrics.SurveyEngine.getEmbeddedData(\"ConditionDeck\");\n\t\n\tconsole.log(\"Deck\", deckString);\n\t\n\tvar deck = deckString.split(\",\");\n\n    var conditionIndex = Number(deck[loopNumber - 1]);\n\n    var randomAnchor = Math.floor(Math.random() * 10) + 1;\n\t\n\tvar qContainer = this.questionContainer;\n\n   \tvar promptHTML = \"\";\n\n\tif (conditionIndex === 0) {\n\n    promptHTML =\n        '<div class=\"prompt-inline\" style =\"font-family:sans-serif; line-height:1.6;color:#333; max-width:700px;margin: 0 auto; font-size: 15px;\">' \n\t\t+'The Image Aesthetics Assessment model gave a rating of: <strong>' +\n        randomAnchor +\n\t\t'<\/strong>';\n\n}\n\n\telse if (conditionIndex === 1) {\n\n    promptHTML =\n        '<div class=\"prompt-inline\" style =\"font-family:sans-serif; line-height:1.6;color:#333; max-width:700px;margin: 0 auto; font-size: 15px;\">' \n\t\t+'Another participant gave a rating of: <strong>' +\n        randomAnchor + \n\t\t'<\/strong>';\n\n}\n\n\tvar prompt = qContainer.querySelector(\"#my-prompt\");\n\n\tif(prompt){\n\n    prompt.innerHTML = promptHTML;\n\n    prompt.style.display = (conditionIndex === 2) ? \"none\" : \"block\";\n\n\tvar counterDiv = qContainer.querySelector(\"#image-counter\");\n\tif (counterDiv) {\n    counterDiv.innerHTML = \"Painting \" + loopNumber + \" of 27\";\n    \/\/ Optional styling\n    counterDiv.style.fontWeight = \"bold\";\n    counterDiv.style.marginBottom = \"10px\";\n\t}\n}\n    \/\/ SAVE IMMEDIATELY\n    Qualtrics.SurveyEngine.setEmbeddedData(\n        \"Cond_\" + loopNumber,\n        conditionIndex\n    );\n\tconsole.log(\n\t\t\"Saved Cond:\",\n\t\tQualtrics.SurveyEngine.getEmbeddedData(\"Cond_\" + loopNumber)\n\t);\n\tconsole.log(\n\t\t\"Savind painting:\",\n\t\t\"${lm:\/\/Field\/1}\"\n\t\t);\n\n    Qualtrics.SurveyEngine.setEmbeddedData(\n        \"Anchor_\" + loopNumber,\n        randomAnchor\n    );\n\n    Qualtrics.SurveyEngine.setEmbeddedData(\n        \"Painting_\" + loopNumber,\n        \"${lm:\/\/Field\/1}\"\n    );\n\n    console.log(\"Saved\");\n    console.log(\"Cond:\", Qualtrics.SurveyEngine.getEmbeddedData(\"Cond_\" + loopNumber));\n    console.log(\"Anchor:\", Qualtrics.SurveyEngine.getEmbeddedData(\"Anchor_\" + loopNumber));\n    console.log(\"Painting:\", Qualtrics.SurveyEngine.getEmbeddedData(\"Painting_\" + loopNumber));\n\n});","Answers":{"1":{"Display":0},"2":{"Display":1},"3":{"Display":2},"4":{"Display":3},"5":{"Display":4},"6":{"Display":5},"7":{"Display":6},"8":{"Display":7},"9":{"Display":8},"10":{"Display":9},"11":{"Display":10}}}},{"SurveyID":"SV_3dVyjdGXdWxhr0O","Element":"SQ","PrimaryAttribute":"QID6","SecondaryAttribute":"Are you colourblind?","TertiaryAttribute":null,"Payload":{"ChoiceOrder":[1,2,3],"Choices":{"1":{"Display":"No, I am not colourblind"},"2":{"Display":"Yes, but I still perceive colours"},"3":{"Display":"Yes, and I do not perceive colours"}},"Configuration":{"QuestionDescriptionOption":"UseText"},"DataExportTag":"Colourblindness","DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"GradingData":[],"Language":[],"NextAnswerId":1,"NextChoiceId":4,"QuestionDescription":"Are you colourblind?","QuestionID":"QID6","QuestionText":"Are you colourblind?","QuestionText_Unsafe":"Are you colourblind?","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}}}},{"SurveyID":"SV_3dVyjdGXdWxhr0O","Element":"SQ","PrimaryAttribute":"QID8","SecondaryAttribute":"In a typical month, how often do you engage in the following activities?","TertiaryAttribute":null,"Payload":{"AnswerOrder":["1","2","3","4","5"],"Answers":{"1":{"Display":"Never"},"2":{"Display":"1-2 times"},"3":{"Display":"3-4 times"},"4":{"Display":"5-6 times"},"5":{"Display":"7+ times"}},"ChoiceDataExportTags":false,"ChoiceOrder":["1","2","3","4","5","6","7"],"Choices":{"1":{"Display":"Visit an art museum or gallery"},"2":{"Display":"Read novels, sho